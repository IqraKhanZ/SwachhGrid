# ──────────────────────────────────────────────────────────────────────────────
# Community Hero Green — Backend Environment Configuration
# MongoDB + JWT + Google OAuth  (zero Firebase dependency)
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Get from: MongoDB Atlas → Cluster → Connect → Drivers → Copy connection string
# Replace <username>, <password>, <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=community_hero_green

# ── JWT Auth ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-string
JWT_EXPIRE_MINUTES=10080

# ── Google OAuth (for Sign in with Google) ────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Add http://localhost:5174 to Authorised JavaScript origins
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from: aistudio.google.com → Get API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── SendGrid (optional — complaint emails) ─────────────────────────────────────
# Set to "skip" to disable email sending
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@communityhergreen.app
SENDGRID_FROM_NAME=Community Hero Green

# ── OpenWeather (optional — hotspot predictions) ──────────────────────────────
# Set to "skip" to disable weather factor
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
CITY_NAME=Pune
CITY_LAT=18.5204
CITY_LON=73.8567

# ── Scheduled Jobs ─────────────────────────────────────────────────────────────
JOB_SECRET_TOKEN=YOUR_SECURE_RANDOM_TOKEN

# ── App ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174

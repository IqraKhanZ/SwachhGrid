# Firebase Configuration — REMOVED (no Firebase in this version)
# This project uses MongoDB Atlas + JWT + Google OAuth

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Add http://localhost:5174 to Authorised JavaScript origins
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Cloudinary (image/video uploads — free tier, no billing needed) ───────────
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET

# ── Backend URL ───────────────────────────────────────────────────────────────
# Local development:
VITE_BACKEND_URL=http://localhost:8001
# Production (replace after deployment):
# VITE_BACKEND_URL=https://community-hero-green-backend-xxxxx.run.app
